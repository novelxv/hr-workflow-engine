# Copy to .env for local development. Never commit .env.

# PostgreSQL 15+ (a Neon branch works). Use the pooled host in production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string; signs session cookies.
JWT_SECRET=

# true behind HTTPS, false on http://localhost
COOKIE_SECURE=false
PORT=8002

# Shared password for the demo accounts, shown on the sign-in page when DEMO_MODE=1.
DEMO_MODE=1
DEMO_PASSWORD=arunika-demo

# Sent by the hourly GitHub Actions job to POST /internal/tick.
INTERNAL_TOKEN=

# Shared secret the HRIS uses to sign POST /hooks/hris (HMAC-SHA256, header
# x-arunika-signature: sha256=<hex>).
HOOK_SECRET=

# Base URL used in links inside webhook payloads.
PUBLIC_APP_URL=http://localhost:3000
